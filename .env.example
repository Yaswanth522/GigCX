# Copy to .env and fill in. All VITE_* values are bundled into the browser build,
# so treat them as public configuration, not secrets.

# SIP-over-WebSocket server (wss://…)
VITE_SIP_WS_URL=
# SIP domain used in addresses, e.g. sip:<bot>@<domain>
VITE_SIP_DOMAIN=
# Yellow.ai bot to call
VITE_BOT_ID=
# Extra SIP headers sent on the call request, separated by "|"
VITE_SIP_EXTRA_HEADERS=
# Caller ID prefix; a per-tab random ID is appended (default: GigCX_webUser_)
VITE_CALLER_ID_PREFIX=GigCX_webUser_
